<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.demo.mapper.EmpMapper">
	<select id="selectEmpList" parameterType="hashmap" resultType="com.example.demo.model.Emp">
		SELECT *
		FROM EMP E
		INNER JOIN SALGRADE S ON E.SAL BETWEEN S.LOSAL AND S.HISAL
		WHERE 1=1 
		<if test="grade != null and grade != ''">
			AND GRADE = #{grade}
		</if>
	</select>
	
	<select id="selectEmp" parameterType="hashmap" resultType="com.example.demo.model.Emp">
		SELECT *
		FROM EMP
		WHERE EMPNO = #{empNo}
	</select>
	
	<select id="selectGradeList" parameterType="hashmap" resultType="com.example.demo.model.Emp">
		SELECT *
		FROM SALGRADE
	</select>
	
	<delete id="deleteEmp" parameterType="hashmap">
		DELETE FROM EMP WHERE EMPNO = #{empNo}
	</delete>

	<insert id="insertEmp" parameterType="hashmap">
		INSERT INTO EMP(EMPNO, ENAME, JOB, SAL)
		VALUES(#{empNo}, #{eName}, #{job}, #{sal})
	</insert>
</mapper>





